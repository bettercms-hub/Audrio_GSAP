# Environment Variables
# Copy this file to .env.local for local development

# No environment variables required for basic setup
# Add your own if needed (e.g., analytics, APIs)

# Example:
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# JobDiva (Careers page sync). Values come from JobDiva support (client ID) and a
# dedicated JobDiva API user (username, password); never commit them.
JOBDIVA_CLIENT_ID=your-jobdiva-client-id
JOBDIVA_API_USERNAME=your-jobdiva-api-username
JOBDIVA_API_PASSWORD=your-jobdiva-api-password

# Airtable (Journal blog sync). A personal access token with data.records:read on the blog base; never commit it.
AIRTABLE_TOKEN=your-airtable-personal-access-token
