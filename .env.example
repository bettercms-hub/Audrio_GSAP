# Environment Variables
# Copy this file to .env.local for local development

# No environment variables required for basic setup
# Add your own if needed (e.g., analytics, APIs)

# Example:
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# JobDiva (Careers page sync). Values come from JobDiva support (client ID) and a
# dedicated JobDiva API user (username, password); never commit them.
JOBDIVA_CLIENT_ID=
JOBDIVA_API_USERNAME=
JOBDIVA_API_PASSWORD=
