{
  "name": "audira-headphones",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bettercms pull-content && next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next",
    "clean:build": "rm -rf .next && next build",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "deploy:cloudflare": "NEXT_PRIVATE_STANDALONE=true npm run build && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare deploy",
    "preview:cloudflare": "NEXT_PRIVATE_STANDALONE=true npm run build && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@bettercms-ai/next": "^0.25.0",
    "gsap": "^3.13.0",
    "marked": "^18.1.1",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@bettercms-ai/cli": "^0.14.7",
    "@opennextjs/cloudflare": "1.15.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
